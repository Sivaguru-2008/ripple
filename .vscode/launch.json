{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ripple",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension",
        "ms-dotnettools.csharp",
        "--disable-extension",
        "ms-dotnettools.csdevkit",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      // Opens the Flask 3.1.3 clone prepared by `npm run demo:prepare` (../flask-demo), with
      // PATH and PYTHONPATH from .env.demo so the agent's `python -m pytest` imports that clone.
      "name": "Run Ripple on the Flask demo",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension",
        "ms-dotnettools.csharp",
        "--disable-extension",
        "ms-dotnettools.csdevkit",
        "${workspaceFolder}/../flask-demo"
      ],
      "envFile": "${workspaceFolder}/.env.demo",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
