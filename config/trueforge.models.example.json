        { "name": "qwen-coder-tools-7b", "modelId": "qwen2.5-coder-tools:7b", "properties": { "contextLength": 32768, "maxOutputTokens": 4096 } },
        { "name": "qwen-coder-tools-7b-16k", "modelId": "qwen2.5-coder-tools-16k:7b", "properties": { "contextLength": 16384, "maxOutputTokens": 4096 } }
