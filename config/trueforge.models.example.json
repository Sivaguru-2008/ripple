{
  "_readme": "Model providers Ripple was tested with, registered in TrueForge by `npm run models` (scripts/setup-models.mjs). Ripple never reads keys and never calls a provider: this file only tells the setup script what to register in TrueForge. Keys are not stored here: \"${NAME}\" is read from the environment or the git-ignored .env file, and a provider whose key is missing is skipped. Copy to config/trueforge.models.json (git-ignored) to change it locally. Base URLs on 127.0.0.1:8794 go through scripts/gemini-proxy.mjs, a model endpoint that smooths provider differences (Gemini thought signatures, Groq reasoning fields, short overloads); it must be running. Shape: ModelProviderManifest of @truefoundry/trueforge-sdk 0.185.0.",
  "providers": [
    {
      "type": "custom",
      "name": "gemini",
      "baseUrl": "http://127.0.0.1:8794/v1",
      "auth": { "apiKey": "${GEMINI_API_KEY}" },
      "models": [
        { "name": "gemini-3-1-flash-lite", "modelId": "gemini-3.1-flash-lite", "properties": { "contextLength": 1048576, "maxOutputTokens": 65536 } },
        { "name": "gemini-3-5-flash-lite", "modelId": "gemini-3.5-flash-lite", "properties": { "contextLength": 1048576, "maxOutputTokens": 65536 } },
        { "name": "gemini-3-5-flash", "modelId": "gemini-3.5-flash", "properties": { "contextLength": 1048576, "maxOutputTokens": 65536 } },
        { "name": "gemini-3-flash-preview", "modelId": "gemini-3-flash-preview", "properties": { "contextLength": 1048576, "maxOutputTokens": 65536 } }
      ]
    },
    {
      "type": "custom",
      "name": "openrouter",
      "baseUrl": "http://127.0.0.1:8794/openrouter/v1",
      "auth": { "apiKey": "${OPENROUTER_API_KEY}" },
      "models": [
        { "name": "nemotron-3-ultra", "modelId": "nvidia/nemotron-3-ultra-550b-a55b:free", "properties": { "contextLength": 1000000, "maxOutputTokens": 16384 } },
        { "name": "gemma-4-31b", "modelId": "google/gemma-4-31b-it:free", "properties": { "contextLength": 262144, "maxOutputTokens": 16384 } }
      ]
    },
    {
      "type": "custom",
      "name": "groq",
      "baseUrl": "http://127.0.0.1:8794/groq/v1",
      "auth": { "apiKey": "${GROQ_API_KEY}" },
      "models": [
        { "name": "gpt-oss-120b", "modelId": "openai/gpt-oss-120b", "properties": { "contextLength": 131072, "maxOutputTokens": 65536 } }
