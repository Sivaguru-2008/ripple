{
  "name": "ripple",
  "displayName": "Ripple",
  "description": "A coding agent for VS Code whose agent loop runs on TrueForge.",
  "version": "0.0.1",
  "publisher": "ripple-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ripple.inlineEdit",
        "title": "Ripple: Inline Edit Selection"
      },
      {
        "command": "ripple.cancel",
        "title": "Ripple: Cancel Run"
      },
      {
        "command": "ripple.undoLastChange",
        "title": "Ripple: Undo Last Applied Change"
      },
      {
        "command": "ripple.acceptHunk",
        "title": "Ripple: Accept Hunk"
      },
      {
        "command": "ripple.rejectHunk",
        "title": "Ripple: Reject Hunk"
      },
      {
        "command": "ripple.acceptAllHunks",
        "title": "Ripple: Accept All Hunks"
      },
      {
        "command": "ripple.rejectAllHunks",
        "title": "Ripple: Reject All Hunks"
      },
      {
        "command": "ripple.smokeTest",
        "title": "Ripple: Smoke Test"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ripple-sidebar",
          "title": "Ripple",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "ripple-sidebar": [
        {
          "type": "webview",
          "id": "ripple.agentView",
          "name": "Ripple Agent"
        }
      ]
    },
    "configuration": {
      "title": "Ripple",
      "properties": {
        "ripple.trueforgeBaseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the local TrueForge server. Use localhost, not 127.0.0.1: on Windows TrueForge listens on ::1 only."
        },
        "ripple.warmUp": {
          "type": "boolean",
          "default": true,
          "description": "Send a short warm-up turn through TrueForge on activation so a local model is loaded before the first edit."
        },
        "ripple.retrievalStyle": {
          "type": "string",
          "enum": ["map", "text"],
          "default": "map",
          "description": "How retrieve_context shows files: \"map\" sends outlines with line ranges and lets the agent read what it needs (small conversations); \"text\" sends whole files or excerpts."
        },
        "ripple.fallbackModel": {
          "type": "string",
          "default": "ollama/qwen-coder-tools-7b",
          "description": "Secondary model to take over automatically when the primary model fails."
        },
        "ripple.perModelConfig": {
          "type": "object",
          "default": {},
          "description": "Per-model context window limits and retrieval token budget overrides."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ripple.acceptHunk",
          "when": "false"
        },
        {
          "command": "ripple.rejectHunk",
          "when": "false"
        },
        {
          "command": "ripple.acceptAllHunks",
          "when": "false"
        },
        {
          "command": "ripple.rejectAllHunks",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ripple.inlineEdit",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "ripple.cancel",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run build && node test/integration/runTest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
